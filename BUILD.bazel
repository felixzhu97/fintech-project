load("@gazelle//:def.bzl", "gazelle")
load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin", "java_test")

package(default_visibility = ["//visibility:public"])

# Go module lives under apps/server-go; prefix is declared there.
gazelle(name = "gazelle")

java_plugin(
    name = "lombok_processor",
    generates_api = True,
    processor_class = "lombok.launch.AnnotationProcessorHider$AnnotationProcessor",
    deps = ["@maven//:org_projectlombok_lombok"],
)

SPRING_DEPS = [
    "@maven//:com_h2database_h2",
    "@maven//:org_postgresql_postgresql",
    "@maven//:org_springframework_boot_spring_boot",
    "@maven//:org_springframework_boot_spring_boot_autoconfigure",
    "@maven//:org_springframework_boot_spring_boot_starter_data_jpa",
    "@maven//:org_hibernate_orm_hibernate_core",
    "@maven//:org_springframework_boot_spring_boot_starter_validation",
    "@maven//:org_springframework_boot_spring_boot_starter_web",
    "@maven//:org_liquibase_liquibase_core",
    "@maven//:org_springframework_spring_beans",
    "@maven//:org_springframework_spring_context",
    "@maven//:org_springframework_spring_core",
    "@maven//:org_springframework_spring_tx",
    "@maven//:org_springframework_spring_web",
    "@maven//:org_springframework_data_spring_data_commons",
    "@maven//:org_springframework_data_spring_data_jpa",
    "@maven//:jakarta_persistence_jakarta_persistence_api",
    "@maven//:jakarta_validation_jakarta_validation_api",
    "@maven//:com_fasterxml_jackson_core_jackson_annotations",
    "@maven//:com_fasterxml_jackson_core_jackson_databind",
    "@maven//:org_projectlombok_lombok",
    "@maven//:org_springframework_security_spring_security_crypto",
]

java_library(
    name = "server_lib",
    srcs = glob(["src/main/java/**/*.java"]),
    plugins = [":lombok_processor"],
    resources = glob(["src/main/resources/**"]),
    deps = SPRING_DEPS,
)

java_binary(
    name = "server",
    main_class = "com.finpulse.server.ServerApplication",
    runtime_deps = [
        ":server_lib",
        "@maven//:com_h2database_h2",
        "@maven//:org_postgresql_postgresql",
        "@maven//:org_springframework_security_spring_security_crypto",
        "@maven//:org_liquibase_liquibase_core",
        "@maven//:org_springframework_boot_spring_boot_starter_data_jpa",
        "@maven//:org_springframework_boot_spring_boot_starter_validation",
        "@maven//:org_springframework_boot_spring_boot_starter_web",
    ],
)

java_test(
    name = "UserPreferenceControllerTest",
    size = "medium",
    srcs = ["src/test/java/com/finpulse/server/preference/controller/UserPreferenceControllerTest.java"],
    args = [
        "--select-class=com.finpulse.server.preference.controller.UserPreferenceControllerTest",
        "--disable-banner",
        "--fail-if-no-tests",
    ],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    plugins = [":lombok_processor"],
    use_testrunner = False,
    runtime_deps = [
        ":server_lib",
        "@maven//:com_h2database_h2",
        "@maven//:org_junit_platform_junit_platform_console",
        "@maven//:org_liquibase_liquibase_core",
        "@maven//:org_springframework_boot_spring_boot_starter_data_jpa",
        "@maven//:org_springframework_boot_spring_boot_starter_test",
        "@maven//:org_springframework_boot_spring_boot_starter_validation",
        "@maven//:org_springframework_boot_spring_boot_starter_web",
        "@maven//:org_springframework_security_spring_security_crypto",
    ],
    deps = [
        ":server_lib",
        "@maven//:com_jayway_jsonpath_json_path",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_projectlombok_lombok",
        "@maven//:org_springframework_boot_spring_boot_starter_test",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_boot_spring_boot_test_autoconfigure",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_test",
        "@maven//:org_springframework_spring_web",
    ],
)

