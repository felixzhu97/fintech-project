@startuml C4-Code-Domain-Model
!include style-zinc.puml

title Code diagram (C4) — FinPulse domain model (DDD)
hide empty members

legend right
  |= Stereotype |= Meaning |
  | <<AggregateRoot>> | Consistency boundary; access via root |
  | <<Entity>> | Identity + lifecycle; private ctor + factory |
  | <<ValueObject>> | Immutable; equality by value |
  | | |
  | **Associations** | Composition = ownership; arrow = reference |
  | **Preferred Terms** | See docs/Glossary.md |
  | **Code note** | Java may still store bare UUID; typed Id VOs are the UL target |
endlegend

note as N_LAYERS
  Feature modules: controller → service → domain ← infra
  Domain is framework-free (no JPA / Spring in domain/).
end note

' ── shared kernel ──────────────────────────────────────────
package "shared kernel (VOs)" as pkg_shared {
  class CustomerId <<ValueObject>> {
    UUID value
  }
  class AccountId <<ValueObject>> {
    UUID value
  }
  class PortfolioId <<ValueObject>> {
    UUID value
  }
  class PositionId <<ValueObject>> {
    UUID value
  }
  class InstrumentId <<ValueObject>> {
    UUID value
  }
  class OrderId <<ValueObject>> {
    UUID value
  }
  class TradeId <<ValueObject>> {
    UUID value
  }
  class WatchlistId <<ValueObject>> {
    UUID value
  }
  class Money <<ValueObject>> {
    BigDecimal amount
    CurrencyCode currency
  }
  class CurrencyCode <<ValueObject>> {
    String code
  }
  class Symbol <<ValueObject>> {
    String value
  }
  class Quantity <<ValueObject>> {
    BigDecimal value
  }
}

' ── customer & account ─────────────────────────────────────
package "customer & account" as pkg_crm {
  class Customer <<AggregateRoot>> {
    CustomerId customerId
    String name
    String email
    KycStatus kycStatus
    Instant createdAt
  }
  enum KycStatus <<ValueObject>> {
    PENDING
    VERIFIED
    REJECTED
  }
  class Account <<Entity>> {
    AccountId accountId
    CustomerId customerId
    AccountType accountType
    CurrencyCode currency
    AccountStatus status
    Instant openedAt
  }
  enum AccountType <<ValueObject>> {
    CASH
    MARGIN
    BROKERAGE
  }
  enum AccountStatus <<ValueObject>> {
    ACTIVE
    CLOSED
    SUSPENDED
  }
  class UserPreference <<Entity>> {
    PreferenceId preferenceId
    CustomerId customerId
    String theme
    String language
    boolean notificationsEnabled
  }
  class PreferenceId <<ValueObject>> {
    UUID value
  }
}

Customer "1" *-- "0..*" Account : owns
Customer "1" o-- "0..1" UserPreference : has
Customer --> CustomerId
Customer --> KycStatus
Account --> AccountId
Account --> CustomerId
Account --> AccountType
Account --> AccountStatus
Account --> CurrencyCode
UserPreference --> PreferenceId
UserPreference --> CustomerId

' ── portfolio ──────────────────────────────────────────────
package "portfolio" as pkg_pf {
  class Portfolio <<AggregateRoot>> {
    PortfolioId portfolioId
    AccountId accountId
    String name
    CurrencyCode baseCurrency
    Instant createdAt
  }
  class Position <<Entity>> {
    PositionId positionId
    PortfolioId portfolioId
    InstrumentId instrumentId
    Quantity quantity
    Money costBasis
    LocalDate asOfDate
  }
}

Account "1" *-- "0..*" Portfolio : holds
Portfolio "1" *-- "0..*" Position : contains
Portfolio --> PortfolioId
Portfolio --> AccountId
Portfolio --> CurrencyCode
Position --> PositionId
Position --> PortfolioId
Position --> InstrumentId
Position --> Quantity
Position --> Money

' ── instrument & market ────────────────────────────────────
package "instrument & market" as pkg_mkt {
  class Instrument <<AggregateRoot>> {
    InstrumentId instrumentId
    Symbol symbol
    String name
    AssetClass assetClass
    CurrencyCode currency
    String exchange
  }
  enum AssetClass <<ValueObject>> {
    EQUITY
    BOND
    OPTION
    OTHER
  }
  class Bond <<Entity>> {
    BondId bondId
    InstrumentId instrumentId
    Money faceValue
    BigDecimal couponRate
    BigDecimal ytm
    BigDecimal duration
    BigDecimal convexity
    BigDecimal maturityYears
    Integer frequency
  }
  class BondId <<ValueObject>> {
    UUID value
  }
  class OptionContract <<Entity>> {
    OptionId optionId
    InstrumentId instrumentId
    InstrumentId underlyingInstrumentId
    Money strike
    Instant expiry
    OptionType optionType
  }
  class OptionId <<ValueObject>> {
    UUID value
  }
  enum OptionType <<ValueObject>> {
    CALL
    PUT
  }
  class MarketData <<Entity>> {
    MarketDataId dataId
    InstrumentId instrumentId
    Instant timestamp
    Money open
    Money high
    Money low
    Money close
    BigDecimal volume
    BigDecimal changePct
  }
  class MarketDataId <<ValueObject>> {
    UUID value
  }
}

Instrument --> InstrumentId
Instrument --> Symbol
Instrument --> AssetClass
Instrument --> CurrencyCode
Instrument "1" o-- "0..1" Bond : extends as
Instrument "1" o-- "0..1" OptionContract : listed as
OptionContract --> Instrument : underlying
Bond --> BondId
Bond --> InstrumentId
Bond --> Money
OptionContract --> OptionId
OptionContract --> InstrumentId
OptionContract --> Money
OptionContract --> OptionType
MarketData --> MarketDataId
MarketData --> InstrumentId
MarketData --> Money
Instrument "1" o-- "0..*" MarketData : priced by

' ── watchlist ──────────────────────────────────────────────
package "watchlist" as pkg_wl {
  class Watchlist <<AggregateRoot>> {
    WatchlistId watchlistId
    CustomerId customerId
    String name
    Instant createdAt
  }
  class WatchlistItem <<Entity>> {
    WatchlistItemId watchlistItemId
    WatchlistId watchlistId
    InstrumentId instrumentId
    Instant addedAt
  }
  class WatchlistItemId <<ValueObject>> {
    UUID value
  }
}

Customer "1" *-- "0..*" Watchlist : follows
Watchlist "1" *-- "0..*" WatchlistItem : contains
Watchlist --> WatchlistId
Watchlist --> CustomerId
WatchlistItem --> WatchlistItemId
WatchlistItem --> WatchlistId
WatchlistItem --> InstrumentId

' ── trading & money ────────────────────────────────────────
package "trading & money" as pkg_trade {
  class TradeOrder <<AggregateRoot>> {
    OrderId orderId
    AccountId accountId
    InstrumentId instrumentId
    OrderSide side
    Quantity quantity
    OrderType orderType
    OrderStatus status
    Instant createdAt
  }
  enum OrderSide <<ValueObject>> {
    BUY
    SELL
  }
  enum OrderType <<ValueObject>> {
    MARKET
    LIMIT
  }
  enum OrderStatus <<ValueObject>> {
    PENDING
    FILLED
    CANCELLED
  }
  class Trade <<Entity>> {
    TradeId tradeId
    OrderId orderId
    Quantity quantity
    Money price
    Money fee
    Instant executedAt
  }
  class Payment <<Entity>> {
    PaymentId paymentId
    AccountId accountId
    String counterparty
    Money amount
    PaymentStatus status
    Instant createdAt
  }
  class PaymentId <<ValueObject>> {
    UUID value
  }
  enum PaymentStatus <<ValueObject>> {
    PENDING
    COMPLETED
    FAILED
  }
  class CashTransaction <<Entity>> {
    CashTransactionId transactionId
    AccountId accountId
    CashTxnType type
    Money amount
    CashTxnStatus status
    Instant createdAt
  }
  class CashTransactionId <<ValueObject>> {
    UUID value
  }
  enum CashTxnType <<ValueObject>> {
    DEPOSIT
    WITHDRAWAL
    FEE
  }
  enum CashTxnStatus <<ValueObject>> {
    COMPLETED
    PENDING
  }
  class Settlement <<Entity>> {
    SettlementId settlementId
    TradeId tradeId
    PaymentId paymentId
    SettlementStatus status
    Instant settledAt
  }
  class SettlementId <<ValueObject>> {
    UUID value
  }
  enum SettlementStatus <<ValueObject>> {
    PENDING
    SETTLED
  }
}

Account "1" *-- "0..*" TradeOrder : places
TradeOrder "1" *-- "0..*" Trade : fills
TradeOrder --> OrderId
TradeOrder --> AccountId
TradeOrder --> InstrumentId
TradeOrder --> OrderSide
TradeOrder --> Quantity
TradeOrder --> OrderType
TradeOrder --> OrderStatus
Trade --> TradeId
Trade --> OrderId
Trade --> Quantity
Trade --> Money
Account "1" *-- "0..*" Payment : funds
Account "1" *-- "0..*" CashTransaction : ledger
Payment --> PaymentId
Payment --> AccountId
Payment --> Money
Payment --> PaymentStatus
CashTransaction --> CashTransactionId
CashTransaction --> AccountId
CashTransaction --> CashTxnType
CashTransaction --> Money
CashTransaction --> CashTxnStatus
Settlement --> SettlementId
Settlement --> TradeId
Settlement --> PaymentId
Settlement --> SettlementStatus
Trade "1" o-- "0..1" Settlement : settled by
Payment "1" o-- "0..1" Settlement : settles

@enduml
