<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user-preference" author="finpulse">
        <comment>Align with scripts/db/schema.sql user_preference</comment>
        <createTable tableName="user_preference">
            <column name="preference_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="theme" type="varchar(64)"/>
            <column name="language" type="varchar(32)"/>
            <column name="notifications_enabled" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-customer-auth" author="finpulse">
        <comment>customer, user_credential, session aligned with scripts/db/schema.sql</comment>
        <createTable tableName="customer">
            <column name="customer_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(512)"/>
            <column name="kyc_status" type="varchar(64)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="user_credential">
            <column name="credential_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="user_credential" indexName="idx_user_credential_email">
            <column name="email"/>
        </createIndex>
        <createTable tableName="session">
            <column name="session_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="session" indexName="idx_session_token">
            <column name="token"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-account" author="finpulse">
        <comment>account aligned with scripts/db/schema.sql</comment>
        <createTable tableName="account">
            <column name="account_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="account_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="opened_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="account" indexName="idx_account_customer">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-create-instrument-bond-option-market-data" author="finpulse">
        <comment>instrument, bond, option, market_data aligned with scripts/db/schema.sql</comment>
        <createTable tableName="instrument">
            <column name="instrument_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="symbol" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(512)"/>
            <column name="asset_class" type="varchar(64)"/>
            <column name="currency" type="varchar(16)"/>
            <column name="exchange" type="varchar(64)"/>
        </createTable>
        <createTable tableName="bond">
            <column name="bond_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="instrument_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="face_value" type="numeric(20, 8)"/>
            <column name="coupon_rate" type="numeric(12, 6)"/>
            <column name="ytm" type="numeric(12, 6)"/>
            <column name="duration" type="numeric(12, 6)"/>
            <column name="convexity" type="numeric(12, 6)"/>
            <column name="maturity_years" type="numeric(8, 4)"/>
            <column name="frequency" type="integer"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="bond" baseColumnNames="instrument_id"
            referencedTableName="instrument" referencedColumnNames="instrument_id"
            constraintName="fk_bond_instrument" onDelete="CASCADE"/>
        <createTable tableName="option">
            <column name="option_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="instrument_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="underlying_instrument_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="strike" type="numeric(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="expiry" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="option_type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="risk_free_rate" type="numeric(12, 6)"/>
            <column name="volatility" type="numeric(12, 6)"/>
            <column name="bs_price" type="numeric(20, 8)"/>
            <column name="delta" type="numeric(12, 6)"/>
            <column name="gamma" type="numeric(12, 6)"/>
            <column name="theta" type="numeric(12, 6)"/>
            <column name="vega" type="numeric(12, 6)"/>
            <column name="rho" type="numeric(12, 6)"/>
            <column name="implied_volatility" type="numeric(12, 6)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="option" baseColumnNames="instrument_id"
            referencedTableName="instrument" referencedColumnNames="instrument_id"
            constraintName="fk_option_instrument" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="option" baseColumnNames="underlying_instrument_id"
            referencedTableName="instrument" referencedColumnNames="instrument_id"
            constraintName="fk_option_underlying_instrument" onDelete="CASCADE"/>
        <createTable tableName="market_data">
            <column name="data_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="instrument_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="timestamp" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="open" type="numeric(20, 8)"/>
            <column name="high" type="numeric(20, 8)"/>
            <column name="low" type="numeric(20, 8)"/>
            <column name="close" type="numeric(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="volume" type="numeric(20, 4)"/>
            <column name="change_pct" type="numeric(12, 6)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="market_data" baseColumnNames="instrument_id"
            referencedTableName="instrument" referencedColumnNames="instrument_id"
            constraintName="fk_market_data_instrument" onDelete="CASCADE"/>
        <createIndex tableName="market_data" indexName="idx_market_data_instrument">
            <column name="instrument_id"/>
        </createIndex>
        <createIndex tableName="market_data" indexName="idx_market_data_timestamp">
            <column name="instrument_id"/>
            <column name="timestamp"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-watchlist" author="finpulse">
        <comment>watchlist and watchlist_item aligned with scripts/db/schema.sql</comment>
        <createTable tableName="watchlist">
            <column name="watchlist_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="watchlist" indexName="idx_watchlist_customer">
            <column name="customer_id"/>
        </createIndex>
        <createTable tableName="watchlist_item">
            <column name="watchlist_item_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="watchlist_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="instrument_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="added_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="watchlist_item" indexName="idx_watchlist_item_watchlist">
            <column name="watchlist_id"/>
        </createIndex>
        <addUniqueConstraint
            tableName="watchlist_item"
            columnNames="watchlist_id, instrument_id"
            constraintName="uk_watchlist_item_watchlist_instrument"/>
    </changeSet>


    <changeSet id="006-create-trading-payments" author="finpulse">
        <comment>portfolio, position, orders, trade, cash_transaction, payment, settlement, realtime_quote</comment>
        <createTable tableName="portfolio">
            <column name="portfolio_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="name" type="varchar(512)"><constraints nullable="false"/></column>
            <column name="base_currency" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="position">
            <column name="position_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="portfolio_id" type="uuid"><constraints nullable="false"/></column>
            <column name="instrument_id" type="uuid"><constraints nullable="false"/></column>
            <column name="quantity" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="cost_basis" type="numeric(20, 8)"/>
            <column name="as_of_date" type="date"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="orders">
            <column name="order_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="instrument_id" type="uuid"><constraints nullable="false"/></column>
            <column name="side" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="quantity" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="order_type" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="trade">
            <column name="trade_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="order_id" type="uuid"><constraints nullable="false"/></column>
            <column name="quantity" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="price" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="fee" type="numeric(20, 8)"/>
            <column name="executed_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="cash_transaction">
            <column name="transaction_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="type" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="amount" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="currency" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="payment">
            <column name="payment_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="counterparty" type="varchar(512)"/>
            <column name="amount" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="currency" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="settlement">
            <column name="settlement_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="trade_id" type="uuid"><constraints nullable="false"/></column>
            <column name="payment_id" type="uuid"><constraints nullable="false"/></column>
            <column name="status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="settled_at" type="timestamp with time zone"/>
        </createTable>
        <createTable tableName="realtime_quote">
            <column name="symbol" type="varchar(64)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="price" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="change" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="change_rate" type="numeric(12, 6)"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="wallet_balance">
            <column name="account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="currency" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="balance" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="wallet_balance" columnNames="account_id, currency" constraintName="pk_wallet_balance"/>
        <createTable tableName="block">
            <column name="block_index" type="integer"><constraints primaryKey="true" nullable="false"/></column>
            <column name="timestamp" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="previous_hash" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="hash" type="varchar(128)"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="chain_transaction">
            <column name="tx_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="block_index" type="integer"><constraints nullable="false"/></column>
            <column name="sender_account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="receiver_account_id" type="uuid"><constraints nullable="false"/></column>
            <column name="amount" type="numeric(20, 8)"><constraints nullable="false"/></column>
            <column name="currency" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>


</databaseChangeLog>
