<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user-preference" author="finpulse">
        <comment>Align with scripts/db/schema.sql user_preference (no FK — customer lives in Go/Python DB)</comment>
        <createTable tableName="user_preference">
            <column name="preference_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="theme" type="varchar(64)"/>
            <column name="language" type="varchar(32)"/>
            <column name="notifications_enabled" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
