load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "finpulse/server-go/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//apps/server-go/docs",
        "//apps/server-go/internal/application",
        "//apps/server-go/internal/config",
        "//apps/server-go/internal/handler",
        "//apps/server-go/internal/infrastructure/cache",
        "//apps/server-go/internal/infrastructure/crypto",
        "//apps/server-go/internal/infrastructure/persistence",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_swaggo_files//:files",
        "@com_github_swaggo_gin_swagger//:gin-swagger",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = ["main_test.go"],
    embed = [":server_lib"],
    deps = [
        "//apps/server-go/internal/application",
        "//apps/server-go/internal/domain",
        "//apps/server-go/internal/handler",
        "@com_github_gin_gonic_gin//:gin",
    ],
)
